{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/auto",
  "commands": {
    "mu88-decisions": {
      "description": "Discuss issues one by one and collect decisions before implementation",
      "template": "{file:./prompts/decisions.md}"
    },
    "mu88-cleanup": {
      "description": "Clean up local and remote development resources",
      "template": "{file:./prompts/cleanup.md}"
    },
    "mu88-instructions": {
      "description": "Consider user-level AI instructions",
      "template": "{file:./prompts/instructions.md}"
    },
    "mu88-quiz": {
      "description": "Create an interactive quiz about this session",
      "template": "{file:./prompts/quiz.md}"
    },
    "mu88-delegate": {
      "description": "Delegate implementation and review the results",
      "template": "{file:./prompts/delegate.md}"
    },
    "mu88-kiss": {
      "description": "Keep the solution focused and simple",
      "template": "{file:./prompts/kiss.md}"
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "sofa", "effect": "ask" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "*.pfx", "effect": "ask" },
    { "action": "read", "resource": "*.p12", "effect": "ask" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "ask" },
    { "action": "read", "resource": "*/.aws/*", "effect": "ask" },
    { "action": "read", "resource": "*/.azure/*", "effect": "ask" },
    { "action": "read", "resource": "*auth.json", "effect": "ask" },
    { "action": "read", "resource": "*credentials*", "effect": "ask" },
    { "action": "read", "resource": "*.npmrc", "effect": "ask" },
    { "action": "read", "resource": "*/.gitconfig*", "effect": "ask" },
    { "action": "read", "resource": "*appsettings*.json", "effect": "ask" },
    { "action": "shell", "resource": "git --version", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status --short", "effect": "allow" },
    { "action": "shell", "resource": "git status --short --branch", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse --show-toplevel", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse --abbrev-ref HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git diff --no-ext-diff --no-textconv", "effect": "allow" },
    { "action": "shell", "resource": "git diff --no-ext-diff --no-textconv --stat", "effect": "allow" },
    { "action": "shell", "resource": "git diff --no-ext-diff --no-textconv --check", "effect": "allow" },
    { "action": "shell", "resource": "git diff --no-ext-diff --no-textconv --cached", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status --short", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status --short --branch", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff --no-ext-diff --no-textconv", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff --no-ext-diff --no-textconv --stat", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff --no-ext-diff --no-textconv --check", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff --no-ext-diff --no-textconv --cached", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --version", "effect": "allow" },
    { "action": "shell", "resource": "dotnet --info", "effect": "allow" },
    { "action": "shell", "resource": "node --version", "effect": "allow" },
    { "action": "shell", "resource": "rtk --version", "effect": "allow" }
  ],
  "agents": {
    "mu88-ai-loop-and-merge": {
      "description": "Runs the mu88 CI and Sonar quality loop, then prepares a merge message without merging. Select explicitly for this workflow.",
      "mode": "primary",
      "system": "{file:../Shared/mu88-ai-loop-and-merge.md}"
    }
  },
  "mcp": {
    "servers": {
      "binlog": {
        "type": "local",
        "command": ["dotnet", "dnx", "Microsoft.AITools.BinlogMcp", "--yes", "--prerelease"],
        "timeout": { "catalog": 120000, "execution": 120000 }
      }
    }
  },
  "plugins": [
    "file:///{env:MU88_DOTFILES}/AI/OpenCode/plugins/rtk",
    "@slkiser/opencode-quota"
  ],
  "instructions": [
    ".github/copilot-instructions.md",
    ".github/instructions/**/*.instructions.md",
    "~/.copilot/copilot-instructions.md",
    "~/.copilot/instructions/*.instructions.md",
    "{env:MU88_DOTFILES}/AI/Shared/instructions/*.instructions.md",
    "{env:MU88_DOTFILES}/AI/Shared/RTK/instructions/rtk.instructions.md"
  ],
  "skills": ["{env:MU88_DOTFILES}/AI/Shared/skills"],
  "experimental": { "todo": true },
  "update": "disable"
}
