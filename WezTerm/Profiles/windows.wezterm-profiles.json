        "icon": "📟",
        "args": [
          "pwsh",
          "-NoLogo",
          "-NoProfile",
          "-Command",
          "& (Join-Path $env:ProgramFiles 'Git/bin/bash.exe')"
        ]
      },
      {
        "guid": "{ffc602aa-8333-48ca-801c-677be1fff69b}",
        "name": "GitHub Copilot CLI (psmux)",
        "args": [
          "pwsh",
          "-NoLogo",
          "-NoExit",
          "-Command",
          "& (Join-Path $env:MU88_DOTFILES 'WindowsTerminal/start-copilot-psmux.ps1')"
        ],
        "environment": {
          "COPILOT_AUTO_UPDATE": "false"
        },
        "suppressApplicationTitle": false,
        "icon": ""
      },
